{
  "_usage_comment": "过敏原（allergen）配置文件格式范例，对应 config/tallergen/allergens/ 目录下的文件。把此文件内容复制为 allergens/<你的id>.json 即可生效（id 需与文件名一致）。改完执行 /tallergen scan 重新加载。注意：本文件中的 // 注释仅用于说明，复制使用时必须全部删除，否则 JSON 解析会失败。",
  "id": "wheat",                        //过敏原id（需与文件名一致）
  "display_name": "Wheat",              //显示名称
  "reaction_id": "wheat_reaction",      //对应的反应id（需与 reactions/ 目录下的反应文件 id 对应）
  "initial_allergy_chance": 0.05,       //初始过敏概率（数值%）：新玩家首次登录随机分配时，该过敏原被选中的概率，0.05=5%
  "foods": [                            //直接携带该过敏原的物品id列表（Recipe Scanner 的种子，会沿配方传播）
    "minecraft:wheat"
  ],
  "exposure_max": 5,                    //暴露值上限
  "decay_interval_ticks": 600,          //暴露衰减间隔（tick）
  "decay_amount": 1,                    //每次衰减的暴露值
  "min_exposure": 0,                    //暴露下限
  "severity_max": 3,                    //最高严重度（1~3）
  "severity_start": 1,                  //起始严重度
  "latency_min_ticks": 200,             //潜伏期下限（tick）
  "latency_max_ticks": 600,             //潜伏期上限（tick）
  "latency_per_exposure": 0.05,         //数值%：每点暴露缩短潜伏期的比例，0.05=5%
  "latency_minimum_multiplier": 0.25,   //数值%：潜伏期缩短下限乘数，0.25=25%
  "severity_per_exposure": 0.02,        //数值%：每点暴露累加到恶化概率的比例，0.02=2%
  "severity_maximum_chance": 0.9,       //数值%：恶化概率上限，0.9=90%
  "severity_base_upgrade_chance": 0.2,  //数值%：恶化基础概率（摄入时的升级判定底数），0.2=20%
  "active_duration_ticks": 400,         //发作（ACTIVE）默认时长（tick）；reaction 的 severity level 未指定时使用
  "attribute_modifier_uuid": "fixed-uuid-wheat-001"  //属性修改器标识（可写任意字符串，最终按 (此值:attributeId) 派生固定 UUID）
}
